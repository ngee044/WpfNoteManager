<Window x:Class="WpfNoteManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfNoteManager.ViewModels"
        xmlns:views="clr-namespace:WpfNoteManager.Views"
        Title="WpfNoteManager" Height="450" Width="700">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <ListBox ItemsSource="{Binding Notes}"
                     SelectedItem="{Binding SelectedNote}"
                     DisplayMemberPath="Title"
                     Height="300" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
            <Button Content="추가" Command="{Binding AddCommand}" Margin="5,0,5,0" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="삭제" Command="{Binding DeleteCommand}" Margin="5,0,5,0" Style="{StaticResource PrimaryButtonStyle}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="저장" Command="{Binding SaveCommand}" Margin="5,0,5,0" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="불러오기" Command="{Binding LoadCommand}" Margin="5,0,5,0" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </StackPanel>

        <views:NoteEditor Grid.Column="1"/>
    </Grid>
</Window>
